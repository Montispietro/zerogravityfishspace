    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .traction-item {
    display: flex;
    gap: 1.2rem;
    padding: 1.5rem;
    border-left: 2px solid var(--cyan);
