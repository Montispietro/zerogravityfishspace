  .tech-card:hover::before { opacity: 1; }

  .tech-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
    display: block;
  }

  .tech-card h3 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.05em;
    color: var(--white);
    margin-bottom: 0.8rem;
