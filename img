    color: var(--cyan);
  }

  .ip-status.pending {
    border: 1px solid rgba(201,168,76,0.4);
    color: var(--gold-light);
  }

  .ip-desc {
    font-size: 0.95rem;
    color: var(--grey);
  }

  /* MARKETS */
  .market-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .market-card {
    padding: 2rem;
    border: 1px solid rgba(255,255,255,0.07);
