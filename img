    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .badge.gold {
    border-color: rgba(201, 168, 76, 0.4);
    background: rgba(201, 168, 76, 0.06);
    color: var(--gold-light);
  }

  .badge::before {
    content: '●';
    font-size: 0.5rem;
  }

