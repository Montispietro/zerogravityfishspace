    position: relative;
    z-index: 1;
    padding: 6rem 3rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--white);
    margin-bottom: 2.5rem;
  }

  /* STATS ROW */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid rgba(0,180,216,0.15);
    margin: 4rem 0;
  }

  .stat {
    padding: 2.5rem 2rem;
    border-right: 1px solid rgba(0,180,216,0.15);
    position: relative;
  }

  .stat:last-child { border-right: none; }

  .stat-number {
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 1;
    color: var(--cyan);
    letter-spacing: 0.02em;
  }

  .stat-unit {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--cyan-dim);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--grey);
    margin-top: 0.5rem;
  }

  /* TECHNOLOGY GRID */
  .tech-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(0,180,216,0.1);
    margin-top: 3rem;
  }

  .tech-card {
    background: var(--deep);
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
    transition: background 0.3s;
  }

  .tech-card:hover { background: rgba(13,59,110,0.4); }

  .tech-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 3px;
    height: 100%;
    background: var(--cyan);
    opacity: 0;
    transition: opacity 0.3s;
