<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zero Gravity Fish Space Ltd — Aquatic Life Support for Space & Earth</title>
<meta name="description" content="Patented aquatic life-support technology reducing water dependency by 90%. Dual-use innovation for space biomedical research and sustainable aquaculture.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Crimson+Pro:ital,wght@0,300;0,400;1,300&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --black: #050810;
    --deep: #080d1a;
    --navy: #0a1628;
    --blue: #0d3b6e;
    --cyan: #00b4d8;
    --cyan-dim: #0077a8;
    --gold: #c9a84c;
    --gold-light: #e8c96a;
    --white: #f0f4ff;
    --grey: #8a9ab5;
    --font-display: 'Bebas Neue', sans-serif;
    --font-body: 'Crimson Pro', serif;
    --font-mono: 'Space Mono', monospace;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--white);
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.7;
    overflow-x: hidden;
  }

  /* STARS BACKGROUND */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: radial-gradient(1px 1px at 10% 15%, rgba(255,255,255,0.8) 0%, transparent 100%),
                      radial-gradient(1px 1px at 25% 60%, rgba(255,255,255,0.5) 0%, transparent 100%),
                      /* ... (resto dello sfondo stelle invariato) ... */
                      radial-gradient(1.5px 1.5px at 20% 40%, rgba(0,180,216,0.4) 0%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  /* HERO */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8rem 3rem 5rem;
    z-index: 1;
    text-align: center;
  }

  .hero-logo {
    max-width: 620px;
    width: 85%;
    margin: 1.5rem auto 2rem;
    display: block;
    mix-blend-mode: screen;
    filter: drop-shadow(0 0 35px rgba(0,180,216,0.6));
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 9rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: var(--white);
    margin-bottom: 0.3rem;
  }

  .hero-title span { color: var(--cyan); display: block; }

  .hero-subtitle {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    letter-spacing: 0.08em;
    color: var(--gold);
    margin-bottom: 2.5rem;
  }

  /* Resto dello stile invariato... */
  @media (max-width: 768px) {
    .hero-logo { max-width: 480px; width: 90%; }
    .hero { padding: 7rem 1.5rem 4rem; }
  }
</style>
</head>
<body>

<nav>
  <div class="nav-logo">ZERO GRAVITY FISH SPACE</div>
  <!-- Nav links... -->
</nav>

<!-- HERO AGGIORNATA -->
<div class="hero">
  <div class="orbit-decoration"></div>
  
  <p class="hero-eyebrow">Deep Tech Pioneer 2026 • London, UK</p>
  
  <!-- LOGO DEEP TECH PIONEER -->
  <img src="/home/workdir/attachments/Deep-Tech-Pioneers_Blue (2).png" 
       alt="Hello Tomorrow Deep Tech Pioneer" 
       class="hero-logo">

  <h1 class="hero-title">
    ZERO GRAVITY<br>
    <span>FISH SPACE</span>
  </h1>
  
  <p class="hero-subtitle">Aquatic Life Support for Space & Earth</p>
  
  <p class="hero-desc" style="max-width: 600px; margin: 0 auto 3rem;">
    Patented technology that reduces water volume by 90%. 
    Dual-use innovation for space biomedical research and sustainable aquaculture.
  </p>

  <div class="hero-badges" style="justify-content: center;">
    <div class="badge">TRL 4–5</div>
    <div class="badge gold">Hello Tomorrow 2026</div>
    <div class="badge">UK Patent Granted</div>
  </div>
</div>

<!-- Il resto della pagina rimane invariato (sezioni tech, IP, markets, traction, contact, footer) -->

<div class="divider"></div>

<!-- ... resto del contenuto ... -->

<footer>
  <p>© 2026 Zero Gravity Fish Space Ltd · Company No. 16720954 · London, UK</p>
  <p>GB2325385A · GB2513140.0</p>
</footer>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

</body>
</html>
